{
  "name": "antlr-odata",
  "repository": {
    "url": "https://github.com/cam-m/antlr-odata",
    "type": "git"
  },
  "version": "0.1.8",
  "description": "Antlr 4 OData Typescript parser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run-script clean & npm run-script antlr & npm run-script compile-src-dist",
    "test": "npm run-script build & npm run-script tests",
    "dev": "npm run-script antlr & concurrently --kill-others \"npm run compile-src-watch\" \"npm run tests-watch\"",
    "compile-src-dist": "tsc -p tsconfig.dist.json",
    "compile-src": "tsc -p tsconfig.json",
    "compile-src-watch": "tsc -w -p tsconfig.json",
    "tests": "tsx --test",
    "tests-watch": "tsx --test --watch",
    "antlr": "antlr-ng -Dlanguage=TypeScript -visitor -listener src/grammar/OData4Lite.g4 -o src"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "odata",
    "odata4",
    "parser",
    "antlr",
    "antlr4",
    "typescript"
  ],
  "author": "Cameron Maunder",
  "license": "MIT",
  "dependencies": {
    "antlr4ng": "^3.0.16",
    "trie-prefix-tree": "^1.5.1",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/assert": "^1.5.6",
    "@types/node": "^26.4.1",
    "@types/trie-prefix-tree": "^1.5.0",
    "@types/xmldom": "^0.1.31",
    "@xmldom/xmldom": "^0.8.2",
    "antlr-ng": "^1.0.10",
    "assert": "^2.0.0",
    "concurrently": "^7.2.2",
    "npm-watch": "^0.11.0",
    "rimraf": "^3.0.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
